rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /canstar_site_data/{docId} {
      allow read, write: if true;
    }
    match /canstar_images/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


